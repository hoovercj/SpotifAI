{
  "name": "spotifai",
  "version": "0.1.0",
  "description": "AI-powered radio station with Gemini-driven DJs, news, and transit segments over a Spotify Premium stream. Fork of chrisallenarmbruster/wyou-radio.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoovercj/SpotifAI.git"
  },
  "bugs": {
    "url": "https://github.com/hoovercj/SpotifAI/issues"
  },
  "homepage": "https://github.com/hoovercj/SpotifAI#readme",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "cross-env NODE_ENV=development vite",
    "dev:api": "cross-env NODE_ENV=development PORT=3001 nodemon --delay 500ms server/index.js --ignore dist/ --ignore client/ --ignore debug/ --ignore public/audio/",
    "build": "cross-env NODE_ENV=production vite build",
    "build:prod": "cross-env NODE_ENV=production vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "prompt": "node scripts/prompt-lab.js",
    "smoke": "node scripts/smoke.js",
    "seed:dj-avatars": "node scripts/seed-dj-avatars.js",
    "eval": "promptfoo eval -c evals/promptfooconfig.yaml",
    "eval:fresh": "promptfoo eval -c evals/promptfooconfig.yaml --no-cache",
    "eval:promote": "node scripts/promote-eval.js",
    "eval:view": "promptfoo view"
  },
  "keywords": [
    "ai-radio",
    "gemini",
    "spotify",
    "tts"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "axios": "^1.7.0",
    "connect-session-sequelize": "^7.1.7",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-session": "^1.18.0",
    "nunjucks": "^3.2.4",
    "pg": "^8.11.5",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "play-sound": "^1.1.6",
    "react-icons": "^5.0.0",
    "rss-parser": "^3.13.0",
    "sequelize": "^6.37.0",
    "socket.io": "^4.7.5",
    "spotify-web-api-node": "^5.0.2",
    "volleyball": "^1.5.1"
  },
  "devDependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@reduxjs/toolkit": "^2.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "formik": "^2.4.5",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.460.0",
    "nanoid": "^5.0.0",
    "nodemon": "^3.1.0",
    "promptfoo": "^0.114.0",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.0",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.23.0",
    "react-spotify-web-playback": "^0.14.0",
    "redux": "^5.0.0",
    "redux-logger": "^3.0.6",
    "swiper": "^11.0.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^4.0.0",
    "vaul": "^1.0.0",
    "vite": "^5.4.0",
    "yup": "^1.4.0"
  }
}
