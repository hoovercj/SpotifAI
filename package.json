{
  "name": "spotifai",
  "version": "0.1.0",
  "description": "AI-powered radio station with Gemini-driven DJs, news, and transit segments over a Spotify Premium stream. Fork of chrisallenarmbruster/wyou-radio.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoovercj/SpotifAI.git"
  },
  "bugs": {
    "url": "https://github.com/hoovercj/SpotifAI/issues"
  },
  "homepage": "https://github.com/hoovercj/SpotifAI#readme",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "cross-env NODE_ENV=development webpack --watch --mode=development",
    "dev:api": "cross-env NODE_ENV=development nodemon --delay 500ms server/index.js --ignore dist/ --ignore client/ --ignore debug/ --ignore public/audio/",
    "build": "cross-env NODE_ENV=development webpack --mode=development",
    "build:prod": "cross-env NODE_ENV=production webpack --mode=production",
    "start": "cross-env NODE_ENV=production node server/index.js"
  },
  "keywords": [
    "ai-radio",
    "gemini",
    "spotify",
    "tts"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "axios": "^1.7.0",
    "connect-session-sequelize": "^7.1.7",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-session": "^1.18.0",
    "less": "^4.2.0",
    "pg": "^8.11.5",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "play-sound": "^1.1.6",
    "react-icons": "^5.0.0",
    "rss-parser": "^3.13.0",
    "sequelize": "^6.37.0",
    "socket.io": "^4.7.5",
    "spotify-web-api-node": "^5.0.2",
    "volleyball": "^1.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@reduxjs/toolkit": "^2.2.0",
    "babel-loader": "^9.1.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "css-loader": "^6.10.0",
    "dotenv-webpack": "^8.1.0",
    "formik": "^2.4.5",
    "less-loader": "^12.2.0",
    "nanoid": "^5.0.0",
    "nodemon": "^3.1.0",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.0",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.23.0",
    "react-spotify-web-playback": "^0.14.0",
    "redux": "^5.0.0",
    "redux-logger": "^3.0.6",
    "style-loader": "^3.3.4",
    "swiper": "^11.0.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "yup": "^1.4.0"
  }
}
