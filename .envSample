# --- Core ---
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
# Matches the spotifai-pg Docker container (Postgres: Up task)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/spotifai
QUIET=TRUE

# --- Spotify (Premium account required for Web Playback SDK) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a redirect URI registered in your Spotify Developer dashboard.
# Local dev: http://127.0.0.1:3000
# Production: https://your-custom-domain.example.com (or the Container App FQDN)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000

# --- Google Gemini (LLM + TTS) ---
# Get a key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- LLM provider (optional overrides) ---
# LLM_PROVIDER=gemini
# GEMINI_TEXT_MODEL=gemini-3.1-flash
# GEMINI_TEXT_TEMPERATURE=1.0

# --- TTS provider (optional overrides) ---
# TTS_PROVIDER=gemini
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts
# TTS_OUTPUT=wav

# --- Weather + location (existing wyou features) ---
OPEN_WEATHER_API_KEY=
LOCATION_IQ_API_KEY=

# --- News (Phase 6b) ---
# Comma-separated list of locales to rotate through for news briefs.
# Supported: dk, es, iowa
NEWS_TOPIC_ROTATION=dk,es,iowa

# --- Copenhagen transit (Phase 6b) ---
# Set to "false" to disable the transit segment entirely.
TRANSIT_ENABLED=true
# Register for a free Rejseplanen access ID at https://www.rejseplanen.dk/labs/
REJSEPLANEN_ACCESS_ID=

ADMIN_EMAILS=
